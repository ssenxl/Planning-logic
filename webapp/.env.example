# Oracle DB (172.16.7.55/NYTG) — จำเป็นสำหรับ View_Stock / View_Booking / View_SC / View_Datamining
# ถ้าไม่ตั้ง จะ fallback เป็น hctr/HCTR#23 (ค่า default) ซึ่งอาจใช้ไม่ได้ → ORA-01017 invalid username/password
SF5_USER=
SF5_PASSWORD=

# OpenAI — สำหรับฟีเจอร์ "จ้างทอ (AI)"
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ไฟล์ .env ไม่ถูก commit เข้า git)
#   cp .env.example .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# (ทางเลือก) endpoint ภายในบริษัท/proxy — เว้นว่างถ้าใช้ OpenAI ตรง
OPENAI_BASE_URL=
